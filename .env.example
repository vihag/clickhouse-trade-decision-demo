# Trade Decision Demo configuration. Copy to .env (./install.sh does this for you).
# Never commit .env. Every value below is optional for the LOCAL path: with no Cloud API key,
# ./install.sh runs everything on Docker on this machine.

# ---------------------------------------------------------------- ClickHouse Cloud (cloud path)
# The only two values you must fill for the cloud path. Console -> Organization -> API keys -> New API key,
# Organization role "Admin" (it creates a service, a Managed Postgres and a ClickPipe).
CLICKHOUSE_CLOUD_API_KEY=
CLICKHOUSE_CLOUD_API_SECRET=
# Optional. Region for new resources (aws). Default us-east-1.
CLICKHOUSE_REGION=
# Optional. Auto-detected when the key sees exactly one organization.
CH_CONSOLE_ORG_ID=
# Optional. Reuse an existing ClickHouse service instead of creating one. If you set it,
# also set CLICKHOUSE_PASSWORD (that service's `default` user password).
CH_CONSOLE_SERVICE_ID=
# Optional. IP/CIDR allowed to reach a NEW service. Default: this machine's public IP (detected).
# Set it if you're behind a VPN/proxy whose exit IP differs, or 0.0.0.0/0 for anywhere (demo data only).
CLICKHOUSE_IP_ALLOW=
# Optional. Names/size for new resources (defaults: trade-decision-demo, trade-demo-pg; PG_SIZE blank = the smallest
# size the region accepts, trying r8gd.medium, r6gd.medium, m6gd.large, ...).
CLICKHOUSE_SERVICE_NAME=
PG_SERVICE_NAME=
PG_SIZE=

# ---------------------------------------------------------------- ClickHouse connection
# Filled in by the installer (cloud: from the API; local: the docker-compose container).
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_SECURE=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Read-only user for the MCP tool. Created by `make bootstrap`, which writes its random password here.
CLICKHOUSE_RO_USER=demo_ro

# ---------------------------------------------------------------- Postgres
# managed = ClickHouse Managed Postgres (cloud path, URL in .pg_conn); local = docker-compose Postgres.
POSTGRES_MODE=
# Local container URL (matches docker-compose.yml). Override only if you changed LOCAL_PG_PORT.
DATABASE_URL_LOCAL=postgresql://demo:demo@127.0.0.1:5433/trade_demo
# Written by the installer on the cloud path. You can also paste your own Managed Postgres URL into
# DATABASE_URL_MANAGED (or the file .pg_conn, which wins).
DATABASE_URL_MANAGED=
PG_CONSOLE_ID=
CLICKPIPE_ID=

# ---------------------------------------------------------------- Langfuse (optional)
# One trace per trade. Empty keys = tracing off (the demo still runs; the Langfuse links hide).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US), matching your project.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------- Optional extras
# Port for the web app on 127.0.0.1. Empty = 8000, or the next free port (the installer writes it here).
APP_PORT=
# Public URL via ngrok (`make tunnel-bg`). Empty NGROK_DOMAIN = a random ngrok URL. Needs `ngrok config add-authtoken`.
NGROK_DOMAIN=
PUBLIC_URL=
# An HTML slide deck to serve read-only at /deck (absolute, or relative to the repo). Empty = no Deck link.
DECK_PATH=
# App observability -> ClickHouse Observability (managed ClickStack). Empty = off. See docs/OBSERVABILITY.md
CLICKSTACK_OTLP_ENDPOINT=
CLICKSTACK_API_KEY=
# Optional overrides (uncomment to use): service.name, observability UI base, service id for its deep links.
# CLICKSTACK_SERVICE_NAME=trade-decision-desk
# CLICKSTACK_UI_URL=https://hyperdx.clickhouse.cloud
# CLICKSTACK_CHC_SERVICE_ID=

# ---------------------------------------------------------------- Local Docker ports (written by the installer)
# Host ports for the local ClickHouse HTTP / Postgres containers. Empty = 8123 / 5433, or the next free port.
# LOCAL_CH_PORT=
# LOCAL_PG_PORT=
